{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "NodeNext",
    "target": "ES2024",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": false,
    "types": [
      "node"
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
